{
 "phrases": [
  {
   "text": "In twenty thirteen,",
   "start": 0.0,
   "end": 1.397
  },
  {
   "text": "a robot on Mars turned one year old.",
   "start": 1.397,
   "end": 3.528
  },
  {
   "text": "So NASA made it sing \"Happy Birthday.\"",
   "start": 3.999,
   "end": 6.712
  },
  {
   "text": "To itself.",
   "start": 6.712,
   "end": 7.312
  },
  {
   "text": "By vibrating its science lab.",
   "start": 7.739,
   "end": 9.451
  },
  {
   "text": "Over two hundred million miles from home.",
   "start": 9.799,
   "end": 12.455
  },
  {
   "text": "It never sang again.",
   "start": 13.054,
   "end": 14.116
  },
  {
   "text": "Singing,",
   "start": 14.626,
   "end": 15.169
  },
  {
   "text": "it turns out,",
   "start": 15.169,
   "end": 16.121
  },
  {
   "text": "has no scientific value.",
   "start": 16.121,
   "end": 17.673
  },
  {
   "text": "But for its tenth birthday,",
   "start": 18.248,
   "end": 19.44
  },
  {
   "text": "an army of robot lawnmowers on Earth sang it back.",
   "start": 19.46,
   "end": 23.06
  },
  {
   "text": "Nobody should have to sing to themselves.",
   "start": 23.573,
   "end": 25.465
  },
  {
   "text": "That's why we made Feeloy.",
   "start": 25.921,
   "end": 27.38
  },
  {
   "text": "Jenny will always answer.",
   "start": 27.56,
   "end": 29.052
  },
  {
   "text": "Search Feeloy on the App Store.",
   "start": 29.502,
   "end": 30.89
  }
 ]
}