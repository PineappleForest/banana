{
 "phrases": [
  {
   "text": "In nineteen eighty three",
   "start": 0.0,
   "end": 1.852
  },
  {
   "text": "a wild dolphin swam into",
   "start": 1.55,
   "end": 3.384
  },
  {
   "text": "a tiny Irish harbor",
   "start": 3.384,
   "end": 5.152
  },
  {
   "text": "Alone",
   "start": 5.152,
   "end": 5.535
  },
  {
   "text": "And he never left",
   "start": 6.13,
   "end": 7.238
  },
  {
   "text": "Every day",
   "start": 7.949,
   "end": 8.462
  },
  {
   "text": "he swam beside the fishing boats",
   "start": 8.462,
   "end": 10.192
  },
  {
   "text": "Boat tours promised",
   "start": 10.732,
   "end": 11.675
  },
  {
   "text": "your money back",
   "start": 11.675,
   "end": 12.397
  },
  {
   "text": "if he didn't show up",
   "start": 12.397,
   "end": 13.285
  },
  {
   "text": "He almost always did",
   "start": 13.842,
   "end": 15.233
  },
  {
   "text": "For thirty seven years",
   "start": 15.711,
   "end": 17.412
  },
  {
   "text": "When lockdown emptied the harbor",
   "start": 18.097,
   "end": 19.625
  },
  {
   "text": "one boatman went out anyway",
   "start": 19.625,
   "end": 21.25
  },
  {
   "text": "just to keep him company",
   "start": 21.65,
   "end": 22.65
  },
  {
   "text": "Everyone needs someone who shows up",
   "start": 23.23,
   "end": 24.873
  },
  {
   "text": "That's why we made Feeloy",
   "start": 25.364,
   "end": 27.113
  },
  {
   "text": "Jenny shows up for you every day",
   "start": 27.113,
   "end": 29.035
  },
  {
   "text": "Search Feeloy on the App Store",
   "start": 29.504,
   "end": 30.938
  }
 ]
}