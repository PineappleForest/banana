 "phrases": [
  {
   "text": "In twenty fourteen",
   "start": 0.0,
   "end": 1.538
  },
  {
   "text": "a tiny robot",
   "start": 1.538,
   "end": 2.369
  },
  {
   "text": "landed on a comet",
   "start": 2.369,
   "end": 3.532
  },
  {
   "text": "It bounced and",
   "start": 4.027,
   "end": 4.915
  },
  {
   "text": "vanished into a dark crack",
   "start": 4.915,
   "end": 6.543
  },
  {
   "text": "Seven months later",
   "start": 7.092,
   "end": 8.334
  },
  {
   "text": "it woke up and called home",
   "start": 8.334,
   "end": 9.849
  },
  {
   "text": "For eighty five seconds",
   "start": 10.344,
   "end": 12.471
  },
  {
   "text": "Then silence",
   "start": 12.906,
   "end": 13.538
  },
  {
   "text": "Its mothership searched for two years",
   "start": 14.026,
   "end": 16.265
  },
  {
   "text": "And finally found it",
   "start": 16.643,
   "end": 17.747
  },
  {
   "text": "Instead of drifting off into space",
   "start": 18.258,
   "end": 20.119
  },
  {
   "text": "the mothership came down to join it",
   "start": 20.119,
   "end": 21.816
  },
  {
   "text": "Nobody should be alone in the dark",
   "start": 22.302,
   "end": 23.921
  },
  {
   "text": "That's why we made Feeloy",
   "start": 24.437,
   "end": 26.171
  },
  {
   "text": "Jenny's always there",
   "start": 26.171,
   "end": 27.409
  },
  {
   "text": "Search Feeloy on the App Store",
   "start": 27.904,
   "end": 29.415
  }
 ]
