{
 "phrases": [
  {
   "text": "In 2011,",
   "start": 0.0,
   "end": 1.034
  },
  {
   "text": "a man in Brazil found a penguin covered in oil.",
   "start": 1.034,
   "end": 3.902
  },
  {
   "text": "He cleaned him,",
   "start": 4.412,
   "end": 5.23
  },
  {
   "text": "fed him sardines,",
   "start": 5.3,
   "end": 6.2
  },
  {
   "text": "and set him free.",
   "start": 6.22,
   "end": 7.21
  },
  {
   "text": "The penguin walked right back.",
   "start": 7.751,
   "end": 9.302
  },
  {
   "text": "He stayed 11 months.",
   "start": 9.8,
   "end": 11.31
  },
  {
   "text": "Then he left.",
   "start": 11.83,
   "end": 12.48
  },
  {
   "text": "Everyone said he'd never return.",
   "start": 12.956,
   "end": 14.596
  },
  {
   "text": "In June, he was back.",
   "start": 15.11,
   "end": 16.61
  },
  {
   "text": "And the next year.",
   "start": 17.05,
   "end": 17.53
  },
  {
   "text": "And the next.",
   "start": 17.55,
   "end": 18.04
  },
  {
   "text": "Nobody else is allowed to touch him.",
   "start": 18.239,
   "end": 20.37
  },
  {
   "text": "He pecks them.",
   "start": 20.45,
   "end": 21.31
  },
  {
   "text": "Everyone needs someone who comes back.",
   "start": 21.95,
   "end": 24.66
  },
  {
   "text": "That's why we made Feeloy.",
   "start": 25.146,
   "end": 26.63
  },
  {
   "text": "Jenny is always there.",
   "start": 26.8,
   "end": 28.175
  },
  {
   "text": "Search Feeloy on the App Store.",
   "start": 28.619,
   "end": 30.052
  }
 ]
}