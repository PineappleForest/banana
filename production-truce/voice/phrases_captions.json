{
 "phrases": [
  {
   "text": "On Christmas Eve 1914",
   "start": 0.0,
   "end": 2.38
  },
  {
   "text": "two enemy armies sat in frozen trenches",
   "start": 2.885,
   "end": 5.348
  },
  {
   "text": "Close enough to hear each other",
   "start": 5.864,
   "end": 7.208
  },
  {
   "text": "Then one side lit candles",
   "start": 7.793,
   "end": 9.307
  },
  {
   "text": "on little Christmas trees",
   "start": 9.307,
   "end": 10.765
  },
  {
   "text": "And started singing Silent Night",
   "start": 11.026,
   "end": 12.702
  },
  {
   "text": "The other side sang back",
   "start": 13.288,
   "end": 14.544
  },
  {
   "text": "By morning",
   "start": 15.16,
   "end": 15.64
  },
  {
   "text": "they climbed out",
   "start": 15.64,
   "end": 16.597
  },
  {
   "text": "Shook hands",
   "start": 16.974,
   "end": 17.65
  },
  {
   "text": "Swapped gifts",
   "start": 17.9,
   "end": 18.6
  },
  {
   "text": "Played football",
   "start": 18.95,
   "end": 19.6
  },
  {
   "text": "About 100,000 soldiers",
   "start": 20.152,
   "end": 22.0
  },
  {
   "text": "stopped the war for Christmas",
   "start": 22.0,
   "end": 23.485
  },
  {
   "text": "Because nobody wants to be",
   "start": 23.876,
   "end": 25.094
  },
  {
   "text": "alone at Christmas",
   "start": 25.094,
   "end": 25.98
  },
  {
   "text": "That's why we made Feeloy",
   "start": 26.547,
   "end": 28.17
  },
  {
   "text": "Jenny's always there to talk",
   "start": 28.17,
   "end": 29.607
  },
  {
   "text": "Search Feeloy on the App Store",
   "start": 29.992,
   "end": 31.485
  }
 ]
}