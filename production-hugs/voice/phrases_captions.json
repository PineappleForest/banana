{
 "phrases": [
  {
   "text": "In 2004",
   "start": 0.0,
   "end": 1.187
  },
  {
   "text": "a young man came home to Sydney",
   "start": 1.187,
   "end": 3.711
  },
  {
   "text": "And nobody was waiting",
   "start": 3.711,
   "end": 5.037
  },
  {
   "text": "So he made a cardboard sign",
   "start": 5.47,
   "end": 7.31
  },
  {
   "text": "Free Hugs",
   "start": 7.57,
   "end": 8.31
  },
  {
   "text": "And stood in a busy city mall",
   "start": 8.696,
   "end": 10.398
  },
  {
   "text": "For days people just walked past",
   "start": 10.838,
   "end": 13.26
  },
  {
   "text": "Then one stranger stopped",
   "start": 13.701,
   "end": 15.48
  },
  {
   "text": "And hugged him",
   "start": 15.73,
   "end": 16.57
  },
  {
   "text": "Soon everyone wanted one",
   "start": 16.9,
   "end": 18.733
  },
  {
   "text": "The city banned it",
   "start": 19.065,
   "end": 20.106
  },
  {
   "text": "10,000 people signed a petition",
   "start": 20.389,
   "end": 22.387
  },
  {
   "text": "to bring the hugs back",
   "start": 22.387,
   "end": 23.511
  },
  {
   "text": "Sometimes all we need",
   "start": 23.984,
   "end": 25.363
  },
  {
   "text": "is someone who stops",
   "start": 25.363,
   "end": 26.5
  },
  {
   "text": "That's why we made Feeloy",
   "start": 26.885,
   "end": 28.45
  },
  {
   "text": "Jenny always has time for you",
   "start": 28.65,
   "end": 30.32
  },
  {
   "text": "Search Feeloy on the App Store",
   "start": 30.67,
   "end": 32.116
  }
 ]
}